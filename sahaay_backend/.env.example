SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PHONE_AUTH_ENABLED=false

# Set to exact browser origins only when deploying the Flutter web app.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Base URL of the standalone AI & Smart Features service (server-to-server only).
AI_SERVICE_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MATCH_REQUEST_TIMEOUT_SECONDS=60

SUPABASE_STORAGE_BUCKET=donations
MAX_FOOD_PHOTO_SIZE_MB=5

# Keep one backend replica with the in-process pollers enabled. See README before
# scaling out or changing scheduler settings.
ESCALATION_SCHEDULER_ENABLED=true
DONATION_OFFER_SCHEDULER_ENABLED=true
ESCALATION_SCHEDULER_INTERVAL_SECONDS=60
